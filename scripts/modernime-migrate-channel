#!/usr/bin/env bash
# modernime-migrate-channel — Controlled installation channel inspection and migration tool
# Supports migrating from install.sh (channel=script) to native system packages (channel=deb / channel=rpm)
# with transactional data backup, old-channel cleanup, target package verification, and full rollback on failure.
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=""
if [[ -f "$script_dir/../uninstall.sh" && -f "$script_dir/modernime-data-guard" ]]; then
    project_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
fi

mode="migrate"
from_prefix=""
target_prefix="/usr"
to_channel=""
package_cmd=""
package_rollback_cmd=""
reinit_session=true

usage() {
    cat <<'EOF'
Usage:
  modernime-migrate-channel --check [--from-prefix PREFIX] [--target-prefix /usr]
  modernime-migrate-channel --to-channel <deb|rpm> [--from-prefix PREFIX] [--target-prefix /usr] [--package-cmd CMD] [--package-rollback-cmd CMD]

Options:
  --check                      Inspect existing installation channel, manifest, ownership, and version
  --from-prefix PREFIX         Source script installation prefix (default: auto-detect ~/.local or /usr)
  --target-prefix PREFIX       Target native package prefix (default: /usr)
  --to-channel CHANNEL         Target native package channel (deb or rpm)
  --package-cmd CMD            Command to install the native package (e.g. "sudo apt install -y modernime")
  --package-rollback-cmd CMD   Command to uninstall the native package on rollback
  --no-session-init            Skip re-initializing user desktop session after migration
  -h, --help                   Show this help message
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --check)
            mode="check"
            shift
            ;;
        --from-prefix=*)
            from_prefix="${1#*=}"
            shift
            ;;
        --from-prefix|--prefix)
            from_prefix="$2"
            shift 2
            ;;
        --target-prefix=*)
            target_prefix="${1#*=}"
            shift
            ;;
        --target-prefix)
            target_prefix="$2"
            shift 2
            ;;
        --to-channel=*)
            to_channel="${1#*=}"
            shift
            ;;
        --to-channel)
            to_channel="$2"
            shift 2
            ;;
        --package-cmd=*)
            package_cmd="${1#*=}"
            shift
            ;;
        --package-cmd)
            package_cmd="$2"
            shift 2
            ;;
        --package-rollback-cmd=*)
            package_rollback_cmd="${1#*=}"
            shift
            ;;
        --package-rollback-cmd)
            package_rollback_cmd="$2"
            shift 2
            ;;
        --no-session-init)
            reinit_session=false
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf 'Error: Unknown argument: %s\n' "$1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

if [[ -z "$from_prefix" ]]; then
    if [[ -n "${MODERNIME_PREFIX:-}" ]]; then
        from_prefix="$MODERNIME_PREFIX"
    elif [[ -f "$HOME/.local/share/modernime/install-manifest.txt" || -f "$HOME/.local/share/modernime/install-channel.txt" ]]; then
        from_prefix="$HOME/.local"
    elif [[ -f "/usr/share/modernime/install-manifest.txt" || -f "/usr/share/modernime/install-channel.txt" ]]; then
        from_prefix="/usr"
    else
        from_prefix="$HOME/.local"
    fi
fi

# Locate and source lifecycle helpers early for boundary and safe removal verification
lifecycle_sh=""
if [[ -n "$project_root" && -f "$project_root/scripts/install_lifecycle.sh" ]]; then
    lifecycle_sh="$project_root/scripts/install_lifecycle.sh"
elif [[ -f "$from_prefix/share/modernime/install_lifecycle.sh" ]]; then
    lifecycle_sh="$from_prefix/share/modernime/install_lifecycle.sh"
elif [[ -f "$script_dir/install_lifecycle.sh" ]]; then
    lifecycle_sh="$script_dir/install_lifecycle.sh"
elif [[ -f "$script_dir/../share/modernime/install_lifecycle.sh" ]]; then
    lifecycle_sh="$script_dir/../share/modernime/install_lifecycle.sh"
fi

if [[ -z "$lifecycle_sh" ]]; then
    printf 'Error: Required lifecycle safety helpers (install_lifecycle.sh) not available; aborting migration to protect prefix boundaries.\n' >&2
    exit 1
fi
# shellcheck disable=SC1090
source "$lifecycle_sh"

find_data_guard() {
    if [[ -n "$project_root" && -x "$project_root/scripts/modernime-data-guard" ]]; then
        printf '%s\n' "$project_root/scripts/modernime-data-guard"
    elif [[ -x "$script_dir/modernime-data-guard" ]]; then
        printf '%s\n' "$script_dir/modernime-data-guard"
    elif [[ -x "$from_prefix/bin/modernime-data-guard" ]]; then
        printf '%s\n' "$from_prefix/bin/modernime-data-guard"
    elif command -v modernime-data-guard >/dev/null 2>&1; then
        command -v modernime-data-guard
    else
        return 1
    fi
}

detect_owner() {
    local f=$1
    local owner=""
    if command -v dpkg >/dev/null 2>&1; then
        owner=$(dpkg -S "$f" 2>/dev/null || true)
    elif command -v rpm >/dev/null 2>&1; then
        owner=$(rpm -qf "$f" 2>/dev/null || true)
    fi
    printf '%s' "$owner"
}

read_channel_field() {
    local cfile=$1
    local key=$2
    if [[ -f "$cfile" ]]; then
        grep -E "^${key}=" "$cfile" 2>/dev/null | head -n 1 | cut -d= -f2- || true
    fi
}

find_addon_dir() {
    local pfx=$1
    for cdir in "$pfx/lib/x86_64-linux-gnu/fcitx5" \
                "$pfx/lib/aarch64-linux-gnu/fcitx5" \
                "$pfx/lib64/fcitx5" \
                "$pfx/lib/fcitx5"; do
        if [[ -f "$cdir/modernime_fcitx5.so" ]]; then
            printf '%s' "$cdir"
            return 0
        fi
    done
    return 1
}

channel_file="$from_prefix/share/modernime/install-channel.txt"
manifest_file="$from_prefix/share/modernime/install-manifest.txt"
detected_channel=$(read_channel_field "$channel_file" "channel")
detected_version=$(read_channel_field "$channel_file" "version")
pkg_owner=""
if [[ -e "$from_prefix/bin/modernime-settings" ]]; then
    pkg_owner=$(detect_owner "$from_prefix/bin/modernime-settings")
fi

if [[ -z "$detected_channel" ]]; then
    if [[ -n "$pkg_owner" ]]; then
        if command -v dpkg >/dev/null 2>&1 && dpkg -S "$from_prefix/bin/modernime-settings" >/dev/null 2>&1; then
            detected_channel="deb"
        else
            detected_channel="rpm"
        fi
    elif [[ -f "$manifest_file" ]]; then
        detected_channel="script"
    elif [[ -e "$from_prefix/bin/modernime-settings" ]]; then
        detected_channel="unknown"
    else
        detected_channel="none"
    fi
fi

data_home="${MODERNIME_DATA_HOME:-"${XDG_DATA_HOME:-"$HOME/.local/share"}"}"
config_home="${MODERNIME_CONFIG_HOME:-"${XDG_CONFIG_HOME:-"$HOME/.config"}"}"
data_dir="$data_home/modernime"
config_dir="$config_home/modernime"

if [[ "$mode" == "check" ]]; then
    printf '=== ModernIME Installation Channel Inspection ===\n'
    printf 'Prefix:            %s\n' "$from_prefix"
    printf 'Detected Channel:  %s\n' "${detected_channel:-unknown}"
    printf 'Detected Version:  %s\n' "${detected_version:-unknown}"
    printf 'Manifest Present:  %s\n' "$([[ -f "$manifest_file" ]] && echo "yes ($manifest_file)" || echo "no")"
    printf 'Package Ownership: %s\n' "${pkg_owner:-unowned}"
    addon_dir=$(find_addon_dir "$from_prefix" || true)
    printf 'Addon Directory:   %s\n' "${addon_dir:-not found}"
    printf 'User Config Dir:   %s (%s)\n' "$config_dir" "$([[ -d "$config_dir" ]] && echo "exists" || echo "absent")"
    printf 'User Data Dir:     %s (%s)\n' "$data_dir" "$([[ -d "$data_dir" ]] && echo "exists" || echo "absent")"
    if [[ "$detected_channel" == "script" ]]; then
        printf '\nRecommended Migration Command (Ubuntu/Debian APT):\n'
        printf '  modernime-migrate-channel --from-prefix "%s" --to-channel deb --package-cmd "sudo apt install -y modernime"\n' "$from_prefix"
        printf 'Recommended Migration Command (openEuler/Fedora DNF):\n'
        printf '  modernime-migrate-channel --from-prefix "%s" --to-channel rpm --package-cmd "sudo dnf install -y modernime"\n' "$from_prefix"
    fi
    exit 0
fi

if [[ -z "$to_channel" ]]; then
    if command -v apt-get >/dev/null 2>&1 || command -v dpkg >/dev/null 2>&1; then
        to_channel="deb"
    elif command -v dnf >/dev/null 2>&1 || command -v rpm >/dev/null 2>&1; then
        to_channel="rpm"
    else
        printf 'Error: Please specify --to-channel deb or --to-channel rpm.\n' >&2
        exit 1
    fi
fi

if [[ "$to_channel" != "deb" && "$to_channel" != "rpm" ]]; then
    printf 'Error: Unsupported target channel "%s" (expected deb or rpm).\n' "$to_channel" >&2
    exit 1
fi

if [[ "$detected_channel" != "script" ]]; then
    printf 'Error: Source installation at %s has channel="%s" (expected channel="script").\n' "$from_prefix" "$detected_channel" >&2
    printf 'Run "modernime-migrate-channel --check --from-prefix %s" to inspect the current installation.\n' "$from_prefix" >&2
    exit 1
fi

if [[ ! -f "$manifest_file" ]]; then
    printf 'Error: Missing install-manifest.txt at %s; cannot safely identify script-managed files to migrate.\n' "$manifest_file" >&2
    exit 1
fi

data_guard_bin=$(find_data_guard || true)
if [[ -z "$data_guard_bin" ]]; then
    printf 'Error: modernime-data-guard not found; refusing to migrate without transactional data backup.\n' >&2
    exit 1
fi

ts="$(date +%Y%m%d%H%M%S 2>/dev/null || echo 0)-$$"
printf '[1/5] Inspecting source installation (channel=%s, version=%s, prefix=%s)...\n' \
    "$detected_channel" "${detected_version:-unknown}" "$from_prefix"

printf '[2/5] Creating verified transactional backup of user configuration and learning data...\n'
user_backup_created=false
user_backup_dir="$data_dir/backups/migrate-$ts"
if ! "$data_guard_bin" --pre-upgrade --data-dir "$data_dir" --config-dir "$config_dir" --tag "migrate-$ts"; then
    printf 'Error: Pre-migration user data backup or integrity check failed; aborting migration. Original installation at %s is untouched.\n' "$from_prefix" >&2
    exit 1
fi
if [[ -f "$user_backup_dir/backup-manifest.json" ]]; then
    user_backup_created=true
fi

# Copy data_guard_bin to a temporary path before removing old prefix files
temp_work=$(mktemp -d "${TMPDIR:-/tmp}/modernime-channel-migrate.XXXXXX")
rollback_prefix_dir="$temp_work/prefix-backup"
rollback_home_dir="$temp_work/home-backup"
mkdir -p "$rollback_prefix_dir" "$rollback_home_dir"
cp "$data_guard_bin" "$temp_work/modernime-data-guard"
chmod +x "$temp_work/modernime-data-guard"

printf '[3/5] Staging rollback snapshot of script-managed files from %s...\n' "$from_prefix"
managed_list="$temp_work/managed-files.txt"
: > "$managed_list"

while IFS= read -r item; do
    [[ -z "$item" ]] && continue
    if [[ -e "$item" || -L "$item" ]]; then
        printf '%s\n' "$item" >> "$managed_list"
        if [[ "$item" == "$from_prefix/"* ]]; then
            rel="${item#"$from_prefix/"}"
            mkdir -p "$rollback_prefix_dir/$(dirname "$rel")"
            cp -a -- "$item" "$rollback_prefix_dir/$rel"
        else
            rel="${item#/}"
            mkdir -p "$rollback_home_dir/$(dirname "$rel")"
            cp -a -- "$item" "$rollback_home_dir/$rel"
        fi
    fi
done < "$manifest_file"

# Also preserve install-manifest.txt and managed-files state directory
if [[ -d "$from_prefix/share/modernime" ]]; then
    mkdir -p "$rollback_prefix_dir/share"
    cp -a -- "$from_prefix/share/modernime" "$rollback_prefix_dir/share/"
fi

package_attempted=false

modernime_is_user_data_path() {
    local p="$1"
    local canon_p
    canon_p=$(readlink -m -- "$p" 2>/dev/null || true)
    [[ -z "$canon_p" ]] && canon_p="$p"

    local canon_data canon_cfg
    canon_data=$(readlink -m -- "$data_dir" 2>/dev/null || true)
    [[ -z "$canon_data" ]] && canon_data="$data_dir"
    canon_cfg=$(readlink -m -- "$config_dir" 2>/dev/null || true)
    [[ -z "$canon_cfg" ]] && canon_cfg="$config_dir"

    if [[ -n "$canon_cfg" && ("$canon_p" == "$canon_cfg" || "$canon_p" == "$canon_cfg"/*) ]]; then
        return 0
    fi

    if [[ -n "$canon_data" && ("$canon_p" == "$canon_data" || "$canon_p" == "$canon_data"/*) ]]; then
        local rel_data=""
        if [[ "$canon_p" == "$canon_data"/* ]]; then
            rel_data="${canon_p#"$canon_data/"}"
        fi

        case "$rel_data" in
            "install-channel.txt" | "install-manifest.txt" | "install_lifecycle.sh" | \
            "pinyin" | "pinyin/"* | "managed-files" | "managed-files/"* | "extensions" | "extensions/"*)
                return 1
                ;;
            *)
                return 0
                ;;
        esac
    fi

    local base_name
    base_name=$(basename -- "$canon_p")
    case "$base_name" in
        user-dictionary.txt | learning.sqlite3* | learning.lmdb* | *.backup-*)
            return 0
            ;;
    esac

    return 1
}

modernime_dir_contains_user_data() {
    local p="$1"
    local canon_p
    canon_p=$(readlink -m -- "$p" 2>/dev/null || true)
    [[ -z "$canon_p" ]] && canon_p="$p"

    local canon_data canon_cfg
    canon_data=$(readlink -m -- "$data_dir" 2>/dev/null || true)
    [[ -z "$canon_data" ]] && canon_data="$data_dir"
    canon_cfg=$(readlink -m -- "$config_dir" 2>/dev/null || true)
    [[ -z "$canon_cfg" ]] && canon_cfg="$config_dir"

    if [[ -n "$canon_cfg" && ("$canon_cfg" == "$canon_p" || "$canon_cfg" == "$canon_p"/*) ]]; then
        return 0
    fi

    if [[ -n "$canon_data" && ("$canon_data" == "$canon_p" || "$canon_data" == "$canon_p"/*) ]]; then
        return 0
    fi

    return 1
}

target_backup_dir="$temp_work/target_backup"
mkdir -p "$target_backup_dir"
target_preexisting_list="$temp_work/target-preexisting.txt"
: > "$target_preexisting_list"
target_dir_mtime_list="$temp_work/target-dir-mtime.txt"
: > "$target_dir_mtime_list"
target_mtime_refs="$temp_work/target_mtime_refs"
mkdir -p "$target_mtime_refs"

dir_ref_idx=0
record_target_dir_metadata() {
    local dir_path="$1"
    local rel_path="$2"
    if grep -q -E "^${rel_path}\t" "$target_dir_mtime_list" 2>/dev/null; then
        return 0
    fi
    dir_ref_idx=$((dir_ref_idx + 1))
    local ref_file="$target_mtime_refs/ref_$dir_ref_idx"
    local rc=0
    touch -r "$dir_path" "$ref_file" 2>/dev/null || {
        rc=$?
        rm -f -- "$ref_file" 2>/dev/null || true
        return "$rc"
    }
    chmod --reference="$dir_path" "$ref_file" 2>/dev/null || {
        rc=$?
        rm -f -- "$ref_file" 2>/dev/null || true
        return "$rc"
    }
    printf '%s\t%s\n' "$rel_path" "$ref_file" >> "$target_dir_mtime_list"
    return 0
}

for pre_file in \
    "$target_prefix/bin/modernime-settings" \
    "$target_prefix/bin/modernime-session-init" \
    "$target_prefix/bin/modernime-data-guard" \
    "$target_prefix/bin/modernime-migrate-channel" \
    "$target_prefix/share/applications/modernime-settings.desktop" \
    "$target_prefix/share/fcitx5/addon/modernime.conf" \
    "$target_prefix/share/fcitx5/addon/modernime-ui.conf" \
    "$target_prefix/share/fcitx5/inputmethod/modernime.conf" \
    "$target_prefix/lib/fcitx5/modernime_fcitx5.so" \
    "$target_prefix/lib/fcitx5/modernime_ui.so" \
    "$target_prefix/lib64/fcitx5/modernime_fcitx5.so" \
    "$target_prefix/lib64/fcitx5/modernime_ui.so" \
    "$target_prefix/lib/x86_64-linux-gnu/fcitx5/modernime_fcitx5.so" \
    "$target_prefix/lib/x86_64-linux-gnu/fcitx5/modernime_ui.so" \
    "$target_prefix/lib/aarch64-linux-gnu/fcitx5/modernime_fcitx5.so" \
    "$target_prefix/lib/aarch64-linux-gnu/fcitx5/modernime_ui.so" \
    "$target_prefix/share/modernime" \
    "$target_prefix/share/doc/modernime"; do
    if [[ -d "$pre_file" && ! -L "$pre_file" ]]; then
        if [[ "$pre_file" == "$target_prefix"/* ]]; then
            rel="${pre_file#"$target_prefix/"}"
            if mkdir -p "$target_backup_dir/$rel"; then
                :
            else
                cp_ec=$?
                printf 'Error: Failed to create target backup directory %s (exit %d)\n' "$target_backup_dir/$rel" "$cp_ec" >&2
                printf 'Pre-migration backup incomplete; aborting migration to protect existing installation.\n' >&2
                printf 'Transaction materials and diagnostics preserved at: %s\n' "$temp_work" >&2
                exit "$cp_ec"
            fi
            chmod --reference="$pre_file" "$target_backup_dir/$rel" 2>/dev/null || true
            record_target_dir_metadata "$pre_file" "$rel" || {
                cp_ec=$?
                printf 'Error: Failed to record directory metadata for %s (exit %d)\n' "$pre_file" "$cp_ec" >&2
                printf 'Pre-migration backup incomplete; aborting migration to protect existing installation.\n' >&2
                printf 'Transaction materials and diagnostics preserved at: %s\n' "$temp_work" >&2
                exit "$cp_ec"
            }
            if ! modernime_is_user_data_path "$pre_file" && ! modernime_dir_contains_user_data "$pre_file"; then
                printf '%s\n' "$pre_file" >> "$target_preexisting_list"
            fi
            while IFS= read -r -d '' sub_item; do
                if modernime_is_user_data_path "$sub_item"; then
                    continue
                fi
                sub_rel="${sub_item#"$target_prefix/"}"
                if [[ -d "$sub_item" && ! -L "$sub_item" ]]; then
                    if mkdir -p "$target_backup_dir/$sub_rel"; then
                        :
                    else
                        cp_ec=$?
                        printf 'Error: Failed to create target backup directory %s (exit %d)\n' "$target_backup_dir/$sub_rel" "$cp_ec" >&2
                        printf 'Pre-migration backup incomplete; aborting migration to protect existing installation.\n' >&2
                        printf 'Transaction materials and diagnostics preserved at: %s\n' "$temp_work" >&2
                        exit "$cp_ec"
                    fi
                    chmod --reference="$sub_item" "$target_backup_dir/$sub_rel" 2>/dev/null || true
                    record_target_dir_metadata "$sub_item" "$sub_rel" || {
                        cp_ec=$?
                        printf 'Error: Failed to record directory metadata for %s (exit %d)\n' "$sub_item" "$cp_ec" >&2
                        printf 'Pre-migration backup incomplete; aborting migration to protect existing installation.\n' >&2
                        printf 'Transaction materials and diagnostics preserved at: %s\n' "$temp_work" >&2
                        exit "$cp_ec"
                    }
                    if ! modernime_dir_contains_user_data "$sub_item"; then
                        printf '%s\n' "$sub_item" >> "$target_preexisting_list"
                    fi
                elif [[ -e "$sub_item" || -L "$sub_item" ]]; then
                    if mkdir -p "$target_backup_dir/$(dirname "$sub_rel")"; then
                        :
                    else
                        cp_ec=$?
                        printf 'Error: Failed to create parent directory for %s (exit %d)\n' "$target_backup_dir/$sub_rel" "$cp_ec" >&2
                        printf 'Pre-migration backup incomplete; aborting migration to protect existing installation.\n' >&2
                        printf 'Transaction materials and diagnostics preserved at: %s\n' "$temp_work" >&2
                        exit "$cp_ec"
                    fi
                    if cp -a -- "$sub_item" "$target_backup_dir/$sub_rel"; then
                        :
                    else
                        cp_ec=$?
                        printf 'Error: Failed to back up existing target file %s to %s (exit %d)\n' "$sub_item" "$target_backup_dir/$sub_rel" "$cp_ec" >&2
                        printf 'Pre-migration backup incomplete; aborting migration to protect existing installation.\n' >&2
                        printf 'Transaction materials and diagnostics preserved at: %s\n' "$temp_work" >&2
                        exit "$cp_ec"
                    fi
                    printf '%s\n' "$sub_item" >> "$target_preexisting_list"
                fi
            done < <(find "$pre_file" -mindepth 1 -print0 2>/dev/null)
        fi
    elif [[ -e "$pre_file" || -L "$pre_file" ]]; then
        if ! modernime_is_user_data_path "$pre_file"; then
            canon_pre=$(readlink -f -- "$pre_file" 2>/dev/null || true)
            if [[ -n "$canon_pre" && "$canon_pre" != "$pre_file" ]]; then
                if [[ "$canon_pre" == "$target_prefix"/* && ( -e "$canon_pre" || -L "$canon_pre" ) ]]; then
                    if ! modernime_is_user_data_path "$canon_pre"; then
                        canon_rel="${canon_pre#"$target_prefix/"}"
                        rm -rf -- "$target_backup_dir/$canon_rel"
                        if mkdir -p "$target_backup_dir/$(dirname "$canon_rel")"; then
                            :
                        else
                            cp_ec=$?
                            printf 'Error: Failed to create parent directory for %s (exit %d)\n' "$target_backup_dir/$canon_rel" "$cp_ec" >&2
                            printf 'Pre-migration backup incomplete; aborting migration to protect existing installation.\n' >&2
                            printf 'Transaction materials and diagnostics preserved at: %s\n' "$temp_work" >&2
                            exit "$cp_ec"
                        fi
                        if cp -a -- "$canon_pre" "$target_backup_dir/$canon_rel"; then
                            :
                        else
                            cp_ec=$?
                            printf 'Error: Failed to back up target file %s to %s (exit %d)\n' "$canon_pre" "$target_backup_dir/$canon_rel" "$cp_ec" >&2
                            printf 'Pre-migration backup incomplete; aborting migration to protect existing installation.\n' >&2
                            printf 'Transaction materials and diagnostics preserved at: %s\n' "$temp_work" >&2
                            exit "$cp_ec"
                        fi
                        printf '%s\n' "$canon_pre" >> "$target_preexisting_list"
                    fi
                fi
            fi
            if [[ "$pre_file" == "$target_prefix"/* ]]; then
                rel="${pre_file#"$target_prefix/"}"
                rm -rf -- "$target_backup_dir/$rel"
                if mkdir -p "$target_backup_dir/$(dirname "$rel")"; then
                    :
                else
                    cp_ec=$?
                    printf 'Error: Failed to create parent directory for %s (exit %d)\n' "$target_backup_dir/$rel" >&2
                    printf 'Pre-migration backup incomplete; aborting migration to protect existing installation.\n' >&2
                    printf 'Transaction materials and diagnostics preserved at: %s\n' "$temp_work" >&2
                    exit "$cp_ec"
                fi
                if cp -a -- "$pre_file" "$target_backup_dir/$rel"; then
                    :
                else
                    cp_ec=$?
                    printf 'Error: Failed to back up target file %s to %s (exit %d)\n' "$pre_file" "$target_backup_dir/$rel" "$cp_ec" >&2
                    printf 'Pre-migration backup incomplete; aborting migration to protect existing installation.\n' >&2
                    printf 'Transaction materials and diagnostics preserved at: %s\n' "$temp_work" >&2
                    exit "$cp_ec"
                fi
                printf '%s\n' "$pre_file" >> "$target_preexisting_list"
            fi
        fi
    fi
done

cleanup_target_prefix_files() {
    local pfx=$1
    local canon_pfx
    canon_pfx=$(modernime_canonical_prefix "$pfx" 2>/dev/null || true)
    [[ -z "$canon_pfx" ]] && return 0
    local is_sys=false
    if [[ "${MODERNIME_FORCE_SYSTEM_PREFIX:-}" == "1" || "$canon_pfx" == "/usr" || "$canon_pfx" == "/usr/local" || "$canon_pfx" == "/opt"* ]]; then
        is_sys=true
    fi

    local file canon_file
    for file in \
        "$pfx/bin/modernime-settings" \
        "$pfx/bin/modernime-session-init" \
        "$pfx/bin/modernime-data-guard" \
        "$pfx/bin/modernime-migrate-channel" \
        "$pfx/share/applications/modernime-settings.desktop" \
        "$pfx/share/fcitx5/addon/modernime.conf" \
        "$pfx/share/fcitx5/addon/modernime-ui.conf" \
        "$pfx/share/fcitx5/inputmethod/modernime.conf" \
        "$pfx/lib/fcitx5/modernime_fcitx5.so" \
        "$pfx/lib/fcitx5/modernime_ui.so" \
        "$pfx/lib64/fcitx5/modernime_fcitx5.so" \
        "$pfx/lib64/fcitx5/modernime_ui.so" \
        "$pfx/lib/x86_64-linux-gnu/fcitx5/modernime_fcitx5.so" \
        "$pfx/lib/x86_64-linux-gnu/fcitx5/modernime_ui.so" \
        "$pfx/lib/aarch64-linux-gnu/fcitx5/modernime_fcitx5.so" \
        "$pfx/lib/aarch64-linux-gnu/fcitx5/modernime_ui.so"; do
        if [[ -e "$file" || -L "$file" ]]; then
            if [[ -f "$target_preexisting_list" ]] && grep -Fxq "$file" "$target_preexisting_list" 2>/dev/null; then
                continue
            fi
            canon_file=$(readlink -f -- "$file" 2>/dev/null || true)
            if [[ -n "$canon_file" && -f "$target_preexisting_list" ]] && grep -Fxq "$canon_file" "$target_preexisting_list" 2>/dev/null; then
                continue
            fi
            if ! modernime_is_safe_removal_target "$file" "$pfx" "$canon_pfx" "$is_sys"; then
                continue
            fi
            rm -f -- "$file" 2>/dev/null || true
        fi
    done
    if [[ -d "$pfx/share/modernime" ]]; then
        while IFS= read -r -d '' item_path; do
            if modernime_is_user_data_path "$item_path" || modernime_dir_contains_user_data "$item_path"; then
                continue
            fi
            if [[ -f "$target_preexisting_list" ]] && grep -Fxq "$item_path" "$target_preexisting_list" 2>/dev/null; then
                continue
            fi
            if [[ -d "$item_path" && ! -L "$item_path" ]]; then
                rmdir -- "$item_path" 2>/dev/null || true
            else
                rm -f -- "$item_path" 2>/dev/null || true
            fi
        done < <(find "$pfx/share/modernime" -mindepth 1 -depth -print0 2>/dev/null)

        if [[ ! -f "$target_preexisting_list" ]] || ! grep -Fxq "$pfx/share/modernime" "$target_preexisting_list" 2>/dev/null; then
            if ! modernime_is_user_data_path "$pfx/share/modernime" && ! modernime_dir_contains_user_data "$pfx/share/modernime"; then
                rmdir -- "$pfx/share/modernime" 2>/dev/null || true
            fi
        fi
    fi
    if [[ -d "$pfx/share/doc/modernime" ]]; then
        while IFS= read -r -d '' item_path; do
            if [[ -f "$target_preexisting_list" ]] && grep -Fxq "$item_path" "$target_preexisting_list" 2>/dev/null; then
                continue
            fi
            if [[ -d "$item_path" && ! -L "$item_path" ]]; then
                rmdir -- "$item_path" 2>/dev/null || true
            else
                rm -f -- "$item_path" 2>/dev/null || true
            fi
        done < <(find "$pfx/share/doc/modernime" -mindepth 1 -depth -print0 2>/dev/null)

        if [[ ! -f "$target_preexisting_list" ]] || ! grep -Fxq "$pfx/share/doc/modernime" "$target_preexisting_list" 2>/dev/null; then
            rmdir -- "$pfx/share/doc/modernime" 2>/dev/null || true
        fi
    fi
}

restore_original_channel() {
    printf '\n[ROLLBACK] Migration failed! Rolling back target package and restoring original script installation at %s...\n' "$from_prefix" >&2
    local rollback_failed=false
    local target_restore_failed=false
    local source_restore_failed=false

    if [[ "$package_attempted" == true ]]; then
        if [[ -n "$package_rollback_cmd" ]]; then
            printf '[ROLLBACK] Uninstalling target %s package via: %s\n' "$to_channel" "$package_rollback_cmd" >&2
            bash -c "$package_rollback_cmd" >/dev/null 2>&1 || true
        elif [[ "$target_prefix" == "/usr" ]]; then
            if [[ "$to_channel" == "deb" ]]; then
                if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
                    apt-get remove -y modernime >/dev/null 2>&1 || dpkg -r modernime >/dev/null 2>&1 || true
                elif command -v sudo >/dev/null 2>&1; then
                    sudo -n apt-get remove -y modernime >/dev/null 2>&1 || sudo -n dpkg -r modernime >/dev/null 2>&1 || true
                fi
            elif [[ "$to_channel" == "rpm" ]]; then
                if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
                    dnf remove -y modernime >/dev/null 2>&1 || rpm -e modernime >/dev/null 2>&1 || true
                elif command -v sudo >/dev/null 2>&1; then
                    sudo -n dnf remove -y modernime >/dev/null 2>&1 || sudo -n rpm -e modernime >/dev/null 2>&1 || true
                fi
            fi
        fi
        cleanup_target_prefix_files "$target_prefix"
        if [[ -d "$target_backup_dir" && -n "$(ls -A "$target_backup_dir" 2>/dev/null)" ]]; then
            local cp_err_file="$temp_work/target_restore_cp.err"
            if ! cp -a --remove-destination -- "$target_backup_dir/." "$target_prefix/" 2>"$cp_err_file"; then
                target_restore_failed=true
                rollback_failed=true
                printf '[ROLLBACK] Error: Failed to restore target backup files from %s to %s\n' \
                    "$target_backup_dir" "$target_prefix" >&2
                if [[ -s "$cp_err_file" ]]; then
                    sed 's/^/[ROLLBACK] /' "$cp_err_file" >&2
                fi
            fi
        fi
        if [[ "$target_restore_failed" == false && -f "$target_dir_mtime_list" ]]; then
            while IFS=$'\t' read -r rel_dir ref_file; do
                [[ -z "$rel_dir" || -z "$ref_file" || ! -f "$ref_file" ]] && continue
                local target_dir="$target_prefix/$rel_dir"
                if [[ -d "$target_dir" && ! -L "$target_dir" ]]; then
                    if modernime_is_user_data_path "$target_dir" || modernime_dir_contains_user_data "$target_dir"; then
                        continue
                    fi
                    if ! chmod --reference="$ref_file" "$target_dir" 2>"$temp_work/target_chmod.err"; then
                        target_restore_failed=true
                        rollback_failed=true
                        printf '[ROLLBACK] Error: Failed to restore directory permissions for %s\n' "$target_dir" >&2
                        if [[ -s "$temp_work/target_chmod.err" ]]; then
                            sed 's/^/[ROLLBACK] /' "$temp_work/target_chmod.err" >&2
                        fi
                    fi
                    if ! touch -r "$ref_file" "$target_dir" 2>"$temp_work/target_touch.err"; then
                        target_restore_failed=true
                        rollback_failed=true
                        printf '[ROLLBACK] Error: Failed to restore directory timestamps for %s\n' "$target_dir" >&2
                        if [[ -s "$temp_work/target_touch.err" ]]; then
                            sed 's/^/[ROLLBACK] /' "$temp_work/target_touch.err" >&2
                        fi
                    fi
                fi
            done < "$target_dir_mtime_list"
        fi
    fi
    if [[ -d "$rollback_prefix_dir" ]]; then
        mkdir -p "$from_prefix"
        local src_err_file="$temp_work/source_restore_cp.err"
        if ! cp -a --remove-destination -- "$rollback_prefix_dir/." "$from_prefix/" 2>"$src_err_file"; then
            source_restore_failed=true
            rollback_failed=true
            printf '[ROLLBACK] Error: Failed to restore source files from %s to %s\n' \
                "$rollback_prefix_dir" "$from_prefix" >&2
        fi
    fi
    if [[ -d "$rollback_home_dir" ]]; then
        while IFS= read -r -d '' bak_file; do
            rel="${bak_file#"$rollback_home_dir/"}"
            dst="/$rel"
            mkdir -p "$(dirname "$dst")"
            if ! cp -a --remove-destination -- "$bak_file" "$dst" 2>/dev/null; then
                source_restore_failed=true
                rollback_failed=true
            fi
        done < <(find "$rollback_home_dir" \( -type f -o -type l \) -print0)
    fi
    if [[ "$user_backup_created" == true ]]; then
        if ! "$temp_work/modernime-data-guard" --restore \
            --data-dir "$data_dir" \
            --config-dir "$config_dir" 2>/dev/null; then
            rollback_failed=true
            printf '[ROLLBACK] Warning: User data-guard restore reported errors.\n' >&2
        fi
    fi

    if [[ "$rollback_failed" == true ]]; then
        printf '[ROLLBACK] Warning: Rollback encountered errors; original installation may not be fully restored.\n' >&2
        printf '[ROLLBACK] Transaction materials and backups preserved at: %s\n' "$temp_work" >&2
        printf 'Recovery Instructions:\n' >&2
        if [[ "$target_restore_failed" == true ]]; then
            printf '  1. Inspect and manually restore target backup files from: %s/target_backup/\n' "$temp_work" >&2
        fi
        printf '  2. Verify your existing installation: %s/bin/modernime-settings --help\n' "$from_prefix" >&2
        printf '  3. Check user data integrity: %s/bin/modernime-data-guard --verify\n' "$from_prefix" >&2
        return 1 2>/dev/null || exit 1
    fi

    printf '[ROLLBACK] Original installation restored (channel=script, version=%s, prefix=%s).\n' \
        "${detected_version:-unknown}" "$from_prefix" >&2
    printf 'Recovery Instructions:\n' >&2
    printf '  1. Verify your existing installation is active: %s/bin/modernime-settings --help\n' "$from_prefix" >&2
    printf '  2. Check user data integrity: %s/bin/modernime-data-guard --verify\n' "$from_prefix" >&2
    printf '  3. Fix package repository/dependency issues and retry modernime-migrate-channel.\n' >&2
    rm -rf -- "$temp_work"
}

printf '[4/5] Cleaning up old script-managed files from %s...\n' "$from_prefix"
if [[ -n "$project_root" && -f "$project_root/uninstall.sh" ]]; then
    if ! MODERNIME_PREFIX="$from_prefix" MODERNIME_SKIP_FCITX_RESTART=1 bash "$project_root/uninstall.sh" --prefix="$from_prefix" >/dev/null 2>&1; then
        printf 'Error: Safe uninstall of old installation failed.\n' >&2
        restore_original_channel
        exit 1
    fi
fi

# Ensure all recorded script files in from_prefix are removed before package installation
while IFS= read -r item; do
    [[ -z "$item" ]] && continue
    if [[ "$item" == "$from_prefix/"* && ( -e "$item" || -L "$item" ) ]]; then
        if ! modernime_is_safe_removal_target "$item" "$from_prefix"; then
            printf 'Warning: Skipping unsafe removal target: %s\n' "$item" >&2
            continue
        fi
        rm -f -- "$item" 2>/dev/null || true
    fi
done < "$managed_list"
rm -f -- "$from_prefix/share/modernime/install-manifest.txt" \
         "$from_prefix/share/modernime/install-channel.txt" 2>/dev/null || true

if [[ -n "$package_cmd" ]]; then
    package_attempted=true
    printf '[5/5] Installing target %s package via: %s\n' "$to_channel" "$package_cmd"
    if ! MODERNIME_MIGRATE_FROM_SCRIPT=1 bash -c "$package_cmd"; then
        printf 'Error: Target package installation command failed.\n' >&2
        restore_original_channel
        exit 1
    fi
else
    printf '[5/5] Verifying target %s package at %s...\n' "$to_channel" "$target_prefix"
fi

if [[ "${MODERNIME_SIMULATE_MIGRATION_FAILURE:-0}" == "1" ]]; then
    printf 'Error: Simulated channel migration failure via MODERNIME_SIMULATE_MIGRATION_FAILURE=1\n' >&2
    restore_original_channel
    exit 1
fi

# Verify target package installation paths, channel metadata, and version
target_channel_file="$target_prefix/share/modernime/install-channel.txt"
target_addon_dir=$(find_addon_dir "$target_prefix" || true)
if [[ ! -x "$target_prefix/bin/modernime-settings" || -z "$target_addon_dir" || ! -f "$target_prefix/share/modernime/pinyin/modernime-knowledge.dict" ]]; then
    printf 'Error: Target package verification failed at %s (missing settings binary, Fcitx5 plugin, or dictionary).\n' "$target_prefix" >&2
    restore_original_channel
    exit 1
fi

new_channel=$(read_channel_field "$target_channel_file" "channel")
new_version=$(read_channel_field "$target_channel_file" "version")
if [[ -n "$new_channel" && "$new_channel" != "$to_channel" ]]; then
    printf 'Error: Target channel mismatch at %s: expected "%s", found "%s".\n' "$target_prefix" "$to_channel" "$new_channel" >&2
    restore_original_channel
    exit 1
fi

if ! "$temp_work/modernime-data-guard" --verify --data-dir "$data_dir" --config-dir "$config_dir"; then
    printf 'Error: Post-migration user data verification failed.\n' >&2
    restore_original_channel
    exit 1
fi

if [[ "$reinit_session" == true && -x "$target_prefix/bin/modernime-session-init" && "${EUID:-$(id -u)}" -ne 0 ]]; then
    MODERNIME_PREFIX="$target_prefix" MODERNIME_SKIP_FCITX_RESTART=1 \
        "$target_prefix/bin/modernime-session-init" >/dev/null 2>&1 || true
fi

rm -rf -- "$temp_work"
printf 'Migration completed successfully!\n'
printf '  New Channel: %s\n' "${new_channel:-$to_channel}"
printf '  New Version: %s\n' "${new_version:-unknown}"
printf '  Target Path: %s\n' "$target_prefix"
printf '  Plugin Path: %s/modernime_fcitx5.so\n' "$target_addon_dir"
