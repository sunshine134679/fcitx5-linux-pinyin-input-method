#!/usr/bin/env bash
# ModernIME User Session Initializer
# Configures user environment, autostart, Fcitx5 profile, and activates ModernIME for desktop sessions.
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
prefix=${MODERNIME_PREFIX:-}
if [[ -z "$prefix" ]]; then
    if [[ "$script_dir" =~ /bin$ ]]; then
        prefix="${script_dir%/bin}"
    else
        prefix="/usr"
    fi
fi

config_home=${MODERNIME_CONFIG_HOME:-"${XDG_CONFIG_HOME:-"$HOME/.config"}"}
data_home=${MODERNIME_DATA_HOME:-"${XDG_DATA_HOME:-"$HOME/.local/share"}"}
if [[ -f "$script_dir/install_state.sh" ]]; then
    source "$script_dir/install_state.sh"
else
    source "$prefix/share/modernime/install_state.sh"
fi
environment_dir="$config_home/environment.d"
environment_file="$environment_dir/90-modernime.conf"
autostart_dir="$config_home/autostart"
autostart_file="$autostart_dir/modernime-fcitx5-session.desktop"
fcitx5_config_dir="$config_home/fcitx5"
fcitx5_profile="$fcitx5_config_dir/profile"

if [[ "${EUID:-$(id -u)}" -eq 0 && -z "${MODERNIME_ALLOW_ROOT:-}" ]]; then
    printf 'Warning: Running modernime-session-init as root will only configure the root account.\n' >&2
    printf 'To configure your normal desktop user session, run this command without sudo as that user.\n' >&2
fi

printf '==> ModernIME User Session Initialization\n'
printf 'Prefix:      %s\n' "$prefix"
printf 'Config home: %s\n' "$config_home"

# 1. Determine Addon & Data directories
candidate_libdirs=("lib/x86_64-linux-gnu" "lib/aarch64-linux-gnu" "lib64" "lib")
prefix_addon_dir=""
for libdir in "${candidate_libdirs[@]}"; do
    if [[ -d "$prefix/$libdir/fcitx5" && -f "$prefix/$libdir/fcitx5/modernime_fcitx5.so" ]]; then
        prefix_addon_dir="$prefix/$libdir/fcitx5"
        break
    fi
done
if [[ -z "$prefix_addon_dir" ]]; then
    for libdir in "${candidate_libdirs[@]}"; do
        if [[ -d "$prefix/$libdir/fcitx5" ]]; then
            prefix_addon_dir="$prefix/$libdir/fcitx5"
            break
        fi
    done
fi
prefix_addon_dir=${prefix_addon_dir:-"$prefix/lib/fcitx5"}

system_addon_dir=""
system_libdir=$(pkg-config --variable=libdir Fcitx5Utils 2>/dev/null || true)
if [[ -n "$system_libdir" ]]; then
    system_addon_dir="$system_libdir/fcitx5"
fi
for sys_dir in /usr/lib64/fcitx5 /usr/lib/x86_64-linux-gnu/fcitx5 /usr/lib/aarch64-linux-gnu/fcitx5 /usr/lib/fcitx5; do
    if [[ -z "$system_addon_dir" && -d "$sys_dir" ]]; then
        system_addon_dir="$sys_dir"
        break
    fi
done
system_addon_dir=${system_addon_dir:-"/usr/lib/fcitx5"}

# 2. Determine data directories
data_directories=${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
case ":$data_directories:" in
    *":$prefix/share:"*) ;;
    *) data_directories="$prefix/share:$data_directories" ;;
esac

# 3. Write environment.d configuration
mkdir -p "$environment_dir"
env_tmp=$(mktemp "$environment_dir/.modernime-env.XXXXXX")
{
    printf 'FCITX_ADDON_DIRS="%s:%s"\n' "$prefix_addon_dir" "$system_addon_dir"
    printf 'XDG_DATA_DIRS="%s/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"\n' "$prefix"
    if [[ -n "${MODERNIME_CONFIG_HOME:-}" ]]; then
        printf 'XDG_CONFIG_HOME="%s"\n' "$config_home"
    fi
    if [[ -n "${MODERNIME_DATA_HOME:-}" ]]; then
        printf 'XDG_DATA_HOME="%s"\n' "$data_home"
    fi
    printf 'GTK_IM_MODULE=fcitx\n'
    printf 'QT_IM_MODULE=fcitx\n'
    printf 'XMODIFIERS=@im=fcitx\n'
    printf 'SDL_IM_MODULE=fcitx\n'
} > "$env_tmp"

# 4. Write autostart entry
mkdir -p "$autostart_dir"
auto_tmp=$(mktemp "$autostart_dir/.modernime-auto.XXXXXX")
autostart_exec="env $(modernime_desktop_argument "FCITX_ADDON_DIRS=$prefix_addon_dir:$system_addon_dir") $(modernime_desktop_argument "XDG_DATA_DIRS=$data_directories") $(modernime_desktop_argument "XDG_CONFIG_HOME=$config_home") $(modernime_desktop_argument "XDG_DATA_HOME=$data_home") fcitx5 -d -u modernime-ui"
{
    printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=ModernIME Fcitx5'
    printf '%s\n' 'Comment=Start Fcitx5 with the ModernIME candidate bar'
    printf 'Exec=%s\n' "$autostart_exec"
    printf '%s\n' 'Terminal=false' 'X-GNOME-Autostart-enabled=true' 'NoDisplay=true'
} > "$auto_tmp"

managed_state_dir="$prefix/share/modernime/managed-files"
if [[ ! -w "$managed_state_dir" && ! -w "$prefix/share/modernime" ]]; then
    # System packages cannot store per-user ownership records in /usr.
    managed_state_dir="$config_home/modernime/session-managed-files"
fi
modernime_write_managed_file "$env_tmp" "$environment_file" environment
modernime_write_managed_file "$auto_tmp" "$autostart_file" autostart
rm -f -- "$env_tmp" "$auto_tmp"

# 4. Configure Fcitx5 profile to ensure modernime is in input method list
mkdir -p "$fcitx5_config_dir"
if [[ -f "$fcitx5_profile" ]]; then
    if ! grep -q 'Name=modernime' "$fcitx5_profile"; then
        # Add modernime to existing profile group 0
        if grep -q '\[Groups/0/Items/0\]' "$fcitx5_profile"; then
            # Find next item index
            next_idx=$(grep -oP '\[Groups/0/Items/\K[0-9]+' "$fcitx5_profile" | sort -n | tail -n 1 || echo 0)
            next_idx=$((next_idx + 1))
            {
                printf '\n[Groups/0/Items/%d]\n' "$next_idx"
                printf 'Name=modernime\n'
                printf 'Layout=\n'
            } >> "$fcitx5_profile"
            printf 'Added ModernIME to Fcitx5 profile: %s (Item %d)\n' "$fcitx5_profile" "$next_idx"
        fi
    else
        printf 'ModernIME already configured in: %s\n' "$fcitx5_profile"
    fi
else
    # Create clean initial profile with keyboard-us and modernime
    {
        printf '[Groups/0]\n'
        printf 'Name=Default\n'
        printf 'Default Layout=us\n'
        printf 'DefaultIM=modernime\n'
        printf '\n[Groups/0/Items/0]\n'
        printf 'Name=keyboard-us\n'
        printf 'Layout=\n'
        printf '\n[Groups/0/Items/1]\n'
        printf 'Name=modernime\n'
        printf 'Layout=\n'
        printf '\n[GroupOrder]\n'
        printf '0=Default\n'
    } > "$fcitx5_profile"
    printf 'Created initial Fcitx5 profile:  %s\n' "$fcitx5_profile"
fi

# 5. GNOME Shell integration for Overview search and native candidate popups
is_gnome=false
current_desktop="${XDG_CURRENT_DESKTOP:-}"
if [[ "$current_desktop" =~ [Gg][Nn][Oo][Mm][Ee] ]] || command -v gnome-shell >/dev/null 2>&1; then
    is_gnome=true
fi

if [[ "$is_gnome" == true ]]; then
    gnome_ext_uuid="kimpanel@kde.org"
    user_ext_dir="$data_home/gnome-shell/extensions/$gnome_ext_uuid"
    bundled_ext_dir=""
    for ext_candidate in \
        "$prefix/share/modernime/extensions/$gnome_ext_uuid" \
        "$script_dir/../data/extensions/$gnome_ext_uuid" \
        "/usr/share/modernime/extensions/$gnome_ext_uuid" \
        "/usr/local/share/modernime/extensions/$gnome_ext_uuid"; do
        if [[ -d "$ext_candidate" && -f "$ext_candidate/metadata.json" ]]; then
            bundled_ext_dir="$ext_candidate"
            break
        fi
    done

    if [[ -n "$bundled_ext_dir" ]]; then
        printf 'Deploying GNOME Shell extension for Overview search: %s\n' "$gnome_ext_uuid"
        mkdir -p "$user_ext_dir"
        cp -rf "$bundled_ext_dir"/. "$user_ext_dir"/
        if command -v glib-compile-schemas >/dev/null 2>&1 && [[ -d "$user_ext_dir/schemas" ]]; then
            glib-compile-schemas "$user_ext_dir/schemas" 2>/dev/null || true
        fi
    fi

    # Ensure extension is enabled if gnome-extensions or gsettings is available
    if command -v gnome-extensions >/dev/null 2>&1; then
        gnome-extensions enable "$gnome_ext_uuid" 2>/dev/null || true
    fi
    if command -v gsettings >/dev/null 2>&1; then
        current_exts=$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null || echo "")
        if [[ -n "$current_exts" && "$current_exts" != *"'$gnome_ext_uuid'"* && "$current_exts" != *"\"$gnome_ext_uuid\""* ]]; then
            if [[ "$current_exts" == "@as []" || "$current_exts" == "[]" ]]; then
                new_exts="['$gnome_ext_uuid']"
            else
                new_exts="${current_exts%\]}, '$gnome_ext_uuid']"
            fi
            gsettings set org.gnome.shell enabled-extensions "$new_exts" 2>/dev/null || true
        fi
    fi
fi

# 6. Reload or restart Fcitx5 in graphical session
skip_restart=false
case "${MODERNIME_SKIP_FCITX_RESTART:-}" in
    1|true|TRUE|yes|YES)
        skip_restart=true
        ;;
esac

if [[ "$skip_restart" == true ]]; then
    printf 'Fcitx5 reload skipped by MODERNIME_SKIP_FCITX_RESTART=1\n'
elif ! command -v fcitx5 >/dev/null 2>&1; then
    printf 'Notice: fcitx5 executable not found in PATH; reload skipped.\n'
elif [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
    printf 'Notice: No active graphical display detected; restart skipped.\n'
elif [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    printf 'Notice: No D-Bus session detected; reload skipped.\n'
else
    fcitx_environment=(env "FCITX_ADDON_DIRS=$prefix_addon_dir:$system_addon_dir"
                       "XDG_DATA_DIRS=$data_directories" "XDG_CONFIG_HOME=$config_home"
                       "XDG_DATA_HOME=$data_home")
    run_remote() {
        "${fcitx_environment[@]}" timeout --kill-after=0.5s 1s fcitx5-remote "$@" 2>/dev/null
    }
    if ! command -v fcitx5-remote >/dev/null 2>&1 || ! command -v timeout >/dev/null 2>&1; then
        printf 'Notice: fcitx5-remote or timeout not found; runtime activation skipped.\n'
    else
        current_state=""
        query_result=0
        current_state=$(run_remote) || query_result=$?
        if [[ "$query_result" == 124 || "$query_result" == 137 ]]; then
            printf 'Fcitx5 could not be activated: status query timed out.\n'
        else
            case "$current_state" in
                0|1|2) run_remote -r >/dev/null || true ;;
                *) "${fcitx_environment[@]}" timeout --kill-after=1s 3s fcitx5 -d -u modernime-ui >/dev/null 2>&1 || true ;;
            esac
            activated=false
            for attempt in {1..10}; do
                query_result=0
                current_state=$(run_remote) || query_result=$?
                if [[ "$query_result" == 124 || "$query_result" == 137 ]]; then break; fi
                if [[ "$current_state" == 0 ]] && run_remote -m modernime >/dev/null; then
                    activated=true
                    break
                fi
                if [[ "$current_state" == 1 || "$current_state" == 2 ]] &&
                   run_remote -s modernime >/dev/null && run_remote -o >/dev/null; then
                    current_im=$(run_remote -n) || current_im=""
                    current_state=$(run_remote) || current_state=""
                    if [[ "$current_im" == modernime && "$current_state" == 2 ]]; then
                        activated=true
                        break
                    fi
                fi
                sleep 0.1
            done
            if [[ "$activated" == true ]]; then
                printf 'Fcitx5 initialized successfully. ModernIME is ready.\n'
            else
                printf 'Fcitx5 could not be activated automatically; check the session and use: fcitx5-remote -s modernime\n'
            fi
        fi
    fi
fi

printf '==> Session initialization complete.\n'
