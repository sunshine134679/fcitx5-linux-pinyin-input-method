#!/usr/bin/env python3
"""Keep an owned Fcitx5 process alive after abnormal exits within this session."""
import fcntl
import hashlib
import os
from pathlib import Path
import signal
import subprocess
import sys
import time
from urllib.parse import unquote


def bus_path(address):
    for transport in address.split(';'):
        if transport.startswith('unix:'):
            for field in transport[5:].split(','):
                if field.startswith('path='):
                    return Path(unquote(field[5:]))
    return None


def same_session_fcitx(address):
    """Do not replace or adopt another launcher’s daemon (nor activate D-Bus)."""
    for entry in Path('/proc').iterdir():
        if not entry.name.isdecimal():
            continue
        try:
            if entry.stat().st_uid != os.getuid() or (entry / 'comm').read_text().strip() != 'fcitx5':
                continue
            env = dict(item.split(b'=', 1) for item in (entry / 'environ').read_bytes().split(b'\0') if b'=' in item)
            other = env.get(b'DBUS_SESSION_BUS_ADDRESS', b'').decode()
            if other.split(',guid=')[0] == address.split(',guid=')[0]:
                return True
        except (OSError, ValueError, UnicodeError):
            continue
    return False


def remote(*arguments):
    try:
        result = subprocess.run(['fcitx5-remote', '--check', *arguments],
                                capture_output=True, text=True, timeout=.5)
        return result.stdout.strip() if result.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def supports_checked_remote():
    try:
        result = subprocess.run(['fcitx5-remote', '--help'], capture_output=True,
                                text=True, timeout=.5)
        return result.returncode == 0 and '--check' in result.stdout
    except (OSError, subprocess.TimeoutExpired):
        return False


def main():
    address = os.environ.get('DBUS_SESSION_BUS_ADDRESS', '')
    if not address or not (os.environ.get('DISPLAY') or os.environ.get('WAYLAND_DISPLAY')):
        return 0
    socket = bus_path(address)
    authority = Path(os.environ['XAUTHORITY']) if os.environ.get('XAUTHORITY') else None
    authority_existed = authority is not None and authority.exists()

    def session_alive():
        return (socket is None or socket.exists()) and (not authority_existed or authority.exists())

    if not session_alive():
        return 0
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    lock_dir = runtime / 'modernime-session'
    lock_dir.mkdir(mode=0o700, exist_ok=True)
    identity = hashlib.sha256(address.split(',guid=')[0].encode()).hexdigest()[:20]
    lock_fd = os.open(lock_dir / (identity + '.lock'), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(lock_fd)
        return 0

    child = None
    stopping = False

    def stop(signum, _frame):
        nonlocal stopping
        stopping = True
        if child is not None and child.poll() is None:
            try:
                child.send_signal(signum)
            except ProcessLookupError:
                pass

    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, stop)
    failures = 0
    checked_remote = supports_checked_remote()
    last_mode = None
    restore_mode = None
    try:
        while not stopping and session_alive():
            if same_session_fcitx(address):
                return 0
            started = time.monotonic()
            child = subprocess.Popen(['fcitx5', '-D'])
            # A signal arriving between the loop check and Popen must stop this child too.
            if stopping:
                child.terminate()
            while True:
                try:
                    result = child.wait(timeout=.5)
                    break
                except subprocess.TimeoutExpired:
                    if not checked_remote or stopping:
                        continue
                    state = remote()
                    # State 0 has no focused input context. Keep the last focused mode.
                    if state not in ('1', '2'):
                        continue
                    if restore_mode is not None:
                        active, method = restore_mode
                        if remote('-s', method) is not None and remote('-o' if active == '2' else '-c') is not None:
                            restore_mode = None
                    else:
                        method = remote('-n')
                        if method:
                            last_mode = (state, method)
            child = None
            if stopping or result in (0, -signal.SIGTERM, -signal.SIGINT, -signal.SIGHUP) or not session_alive():
                return 0
            if time.monotonic() - started >= 60:
                failures = 0
            if failures >= 3:
                print('ModernIME: Fcitx5 repeatedly failed; automatic recovery stopped.', file=sys.stderr)
                return 1
            delay = 2 ** failures
            failures += 1
            # This snapshot stays in memory and contains no preedit or committed text.
            restore_mode = last_mode
            print(f'ModernIME: Fcitx5 exited abnormally ({result}); retry {failures}/3 in {delay}s.', file=sys.stderr)
            deadline = time.monotonic() + delay
            while not stopping and time.monotonic() < deadline:
                time.sleep(min(.1, max(0, deadline - time.monotonic())))
        return 0
    finally:
        os.close(lock_fd)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except OSError as error:
        print(f'ModernIME session startup failed: {error}', file=sys.stderr)
        sys.exit(1)
