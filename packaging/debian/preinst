#!/bin/sh
set -e

pkg_root="${MODERNIME_PKG_ROOT:-}"

case "$1" in
    install|upgrade)
        # Prevent silent overwrite or dual-prefix conflict with a manual install.sh installation in /usr or /usr/local
        for prefix_dir in "${pkg_root}/usr" "${pkg_root}/usr/local"; do
            if [ -f "${prefix_dir}/share/modernime/install-channel.txt" ]; then
                existing_channel=$(grep -E '^channel=' "${prefix_dir}/share/modernime/install-channel.txt" 2>/dev/null | head -n 1 | cut -d= -f2 || true)
                if [ "$existing_channel" = "script" ] && [ "${MODERNIME_MIGRATE_FROM_SCRIPT:-0}" != "1" ]; then
                    echo "Error: Detected an existing script-based ModernIME installation in ${prefix_dir} (channel=script)." >&2
                    echo "To migrate safely to the native DEB package without file ownership conflicts:" >&2
                    echo "  1. Run: sudo modernime-migrate-channel --to-channel deb --package-cmd \"sudo apt install -y modernime\"" >&2
                    echo "  2. Or uninstall the script installation first: sudo ./uninstall.sh --prefix=${prefix_dir}" >&2
                    exit 1
                fi
            elif [ -f "${prefix_dir}/share/modernime/install-manifest.txt" ] && [ "${MODERNIME_MIGRATE_FROM_SCRIPT:-0}" != "1" ]; then
                echo "Error: Detected an existing script-managed install-manifest.txt in ${prefix_dir}." >&2
                echo "Please migrate or uninstall the script installation before installing the DEB package." >&2
                exit 1
            fi
        done

        # If upgrading and modernime-data-guard is available, back up user learning data
        if [ "$1" = "upgrade" ] && [ -x "${pkg_root}/usr/bin/modernime-data-guard" ]; then
            "${pkg_root}/usr/bin/modernime-data-guard" --pre-upgrade
        fi
    ;;
esac

exit 0
